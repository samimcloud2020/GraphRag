# ── OpenAI ──────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Neo4j Aura ──────────────────────────────────────────────────
NEO4J_URI=neo4j+s://0bd407b0.databases.neo4j.io
NEO4J_USERNAME=0bd407b0
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=0bd407b0

# ── Optional: HuggingFace ───────────────────────────────────────
# Speeds up cross-encoder model downloads and avoids rate limits
HF_TOKEN=hf_your-token-here

# ── Optional: Neo4j connection tuning ───────────────────────────
# For Aura, recycle idle connections before the server drops them
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60
